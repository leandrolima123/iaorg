# Copie para .env e ajuste. A chave do Claude NÃO fica mais aqui:
# cada empresa cadastra a sua no onboarding (guardada criptografada).

# Endereço público do app e do Keycloak (como o navegador acessa)
APP_URL=http://localhost:3000
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Segredo do app: assina sessões e criptografa chaves das empresas.
# Gere um valor longo e aleatório (ex.: openssl rand -hex 32). Não troque depois,
# senão as chaves já salvas deixam de abrir.
APP_SECRET=
# Oficina: segredo entre o app e o runner (gere com: openssl rand -hex 32)
RUNNER_TOKEN=
# Quantos trabalhos da oficina rodam ao mesmo tempo no servidor
RUNNER_MAX_JOBS=4

# Segredos dos clients do Keycloak (aplicados no import do realm na primeira subida)
KEYCLOAK_CLIENT_SECRET=troque-este-segredo-app
KEYCLOAK_ADMIN_CLIENT_SECRET=troque-este-segredo-admin

# Senha do usuário "admin" do console do Keycloak (http://localhost:8081)
KC_ADMIN_PASSWORD=admin

# Senha do Postgres do Keycloak
POSTGRES_PASSWORD=troque-esta-senha

# Google (Gmail e Agenda): cliente OAuth "Aplicativo da Web" no Google Cloud Console,
# com redirect URI  ${APP_URL}/integrations/google/callback  (ex.: http://localhost:3000/integrations/google/callback)
# e as APIs Gmail e Google Calendar ativadas. Sem isso, Gmail/Agenda ficam indisponíveis no catálogo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# De quanto em quanto tempo checar caixas de entrada (Resend/Gmail) para avisar os agentes
INBOX_POLL_SECONDS=60

# Limites do motor (valem para cada empresa)
MAX_CONCURRENT_AGENTS=3
AGENT_MAX_STEPS=10
# Modelo padrão sugerido no onboarding
DEFAULT_CLAUDE_MODEL=claude-haiku-5-5

# Portas publicadas no host
PORT=3000
KEYCLOAK_PORT=8081
